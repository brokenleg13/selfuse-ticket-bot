{
    "manifest_version": 3,
    "name": "EasyConcertKorea",
    "description": "A ticket helper for Interpark, Yes24, and Melon Ticket.",
    "version": "1.0",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "declarativeNetRequest",
        "downloads",
        "offscreen"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_yes24",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "host_permissions": [
        "https://ticket.yes24.com/*",
        "https://cdn-botmanager.stclab.com/*",
        "https://world.nol.com/*",
        "https://tickets.interpark.com/*",
        "https://gpoticket.globalinterpark.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "scripts/yes24/antibot.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://ticket.yes24.com/*",
                "https://tkglobal.melon.com/*",
                "https://world.nol.com/*",
                "https://tickets.interpark.com/*",
                "https://gpoticket.globalinterpark.com/*"
            ],
            "js": [
                "scripts/common/beforeunload-blocker.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": [
                "https://ticket.yes24.com/Pages/English/Sale/FnPerfSaleProcess.aspx",
                "https://ticket.yes24.com/Pages/English/Sale/FnPerfSaleProcess.aspx*"
            ],
            "js": [
                "config/config.js",
                "scripts/common/feishubot.js",
                "scripts/common/hourToPm.js",
                "scripts/common/storage.js",
                "scripts/common/sleep.js",
                "scripts/common/captcha-client.js",
                "scripts/common/sound.js",
                "scripts/common/status-panel.js",
                "scripts/common/main-world.js",
                "scripts/common/journal.js",
                "scripts/common/runtime.js",
                "scripts/yes24/seatv2.js"
            ]
        },
        {
            "matches": [
                "https://tkglobal.melon.com/reservation/popup/onestop.htm/*",
                "https://tkglobal.melon.com/reservation/popup/onestop.htm"
            ],
            "js": [
                "config/config.js",
                "scripts/common/feishubot.js",
                "scripts/common/storage.js",
                "scripts/common/sleep.js",
                "scripts/common/captcha-client.js",
                "scripts/common/sound.js",
                "scripts/common/status-panel.js",
                "scripts/common/main-world.js",
                "scripts/common/journal.js",
                "scripts/common/runtime.js",
                "scripts/melonticket/seat.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://tkglobal.melon.com/performance/index.htm*",
                "https://tkglobal.melon.com/performance/index.htm"
            ],
            "js": [
                "config/config.js",
                "scripts/common/feishubot.js",
                "scripts/common/hourToPm.js",
                "scripts/common/storage.js",
                "scripts/common/sleep.js",
                "scripts/common/captcha-client.js",
                "scripts/common/sound.js",
                "scripts/common/status-panel.js",
                "scripts/common/main-world.js",
                "scripts/common/journal.js",
                "scripts/common/runtime.js",
                "scripts/melonticket/concert.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://world.nol.com/*/ticket/places/*/products/*",
                "https://world.nol.com/*/ticket/genre/*/products/*",
                "https://world.nol.com/ticket/places/*/products/*",
                "https://world.nol.com/ticket/genre/*/products/*",
                "https://tickets.interpark.com/waiting*",
                "https://tickets.interpark.com/gates/*",
                "https://tickets.interpark.com/onestop/*",
                "https://tickets.interpark.com/onestop",
                "https://tickets.interpark.com/onestop?*",
                "https://gpoticket.globalinterpark.com/Global/Play/Book/BookMain.asp*"
            ],
            "js": [
                "config/config.js",
                "scripts/common/feishubot.js",
                "scripts/common/storage.js",
                "scripts/common/sleep.js",
                "scripts/common/captcha-client.js",
                "scripts/common/sound.js",
                "scripts/common/status-panel.js",
                "scripts/common/main-world.js",
                "scripts/common/journal.js",
                "scripts/common/runtime.js",
                "scripts/interpark/seat.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_popup": "popup/mainPage/index.html",
        "default_icon": "assets/logo_easy_korea_concert.png"
    },
    "icons": {
        "16": "assets/logo_easy_korea_concert.png",
        "48": "assets/logo_easy_korea_concert.png",
        "128": "assets/logo_easy_korea_concert.png"
    }
}
